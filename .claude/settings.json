{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(du *)",
      "Bash(wc *)",
      "Bash(find * -name *.jsonl *)",
      "Bash(ls *)",
      "Bash(cat ~/.claude/history.jsonl *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(rsync *)",
      "Bash(tailscale *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
